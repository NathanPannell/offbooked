{
  "name": "offbooked-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=4 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
