{
  "name": "offbooked-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=4 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:coverage": "node --env-file-if-exists=.env --test --test-concurrency=4 --experimental-test-coverage --test-coverage-lines=93 --test-coverage-branches=84 --test-coverage-functions=90 \"src/**/*.test.ts\"",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"bench/*.ts\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"bench/*.ts\" eslint.config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "fastify": "^5.12.7",
    "mammoth": "^1.13.0",
    "postgres": "^3.4.9",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "diff": "^9.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
